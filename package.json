{
  "name": "fatfish-world-dsh",
  "version": "0.2.3",
  "description": "DeepSeek Harness bundle for fatfish.world (大肥鱼世界): local MCP tools plus the portable fatfish-world Skill.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "fatfish-world": "0.2.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-mcp-client": "*"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m1eb0/fatfish-world-dsh.git"
  },
  "homepage": "https://fatfish.world",
  "bugs": {
    "url": "https://github.com/m1eb0/fatfish-world-dsh/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "fatfish-world",
    "agent"
  ]
}
